#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Launcher for the TECH watcher (mid-level SWE roles).
#
# `setup.sh` copies this to run_tech.sh, which is git-ignored — so your password
# is never committed, and `git pull` never overwrites it.
#
# Fill in the three values below, then run:  ./run_tech.sh --preview
# ---------------------------------------------------------------------------
cd "$(dirname "$0")" || exit 1

# 1. The Gmail account that SENDS the alerts (it owns the app password below).
export EMAIL_USER="you@gmail.com"

# 2. A Gmail APP PASSWORD — 16 characters, NOT your normal login password.
#    Create one at: https://myaccount.google.com/apppasswords
#    (turn on 2-Step Verification first). No spaces around the "=".
export EMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# 3. Where the job alerts should land (can be the same address).
export EMAIL_TO="you@gmail.com"

# Not using Gmail? Also set these (587 -> STARTTLS, 465 -> SSL):
#   export EMAIL_SMTP_HOST="smtp.yourprovider.com"
#   export EMAIL_SMTP_PORT="465"

# ---------------------------------------------------------------------------
# Google Sheets sync (optional) — appends every new mid-level role to your
# application tracker. Leave GSHEET_CREDENTIALS commented out to turn it off.
# Setup walkthrough: tech/SHEETS_SETUP.md
# ---------------------------------------------------------------------------

# Path to the service-account JSON key. This file is a credential — keep it
# outside the repo so it can never be committed.
# export GSHEET_CREDENTIALS="$HOME/.config/job-scraper/gsheet-service-account.json"

# Which spreadsheet and which tab. These already point at the tracker; change
# them only if you move to a different sheet.
# export GSHEET_ID="1kntHhfWMeW1EeT8ZPfse8FzMQQkOzUnIg2AQqTp7z3w"
# export GSHEET_GID="1940679258"

exec .venv/bin/python tech/tech_watcher.py "$@"
