<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the tech (mid-level SWE) watcher's macOS LaunchAgent.

  Do NOT edit this file and copy it by hand — run  ./tech/install_agent.sh install
  which substitutes __REPO__ / __INTERVAL__ and installs it to
  ~/Library/LaunchAgents/com.kavin.techwatcher.plist.

  It runs `--once` on a timer rather than holding an `--interval` loop open: each fire
  is a fresh process, so a `git pull` that adds companies is picked up automatically
  on the next run.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kavin.techwatcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/run_tech.sh</string>
    <string>--once</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- Seconds between runs. A run missed while the laptop slept fires once on wake. -->
  <key>StartInterval</key>
  <integer>__INTERVAL__</integer>

  <!-- Also run immediately when the agent is loaded (login, reboot, install). -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__REPO__/launchd.tech.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/launchd.tech.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
